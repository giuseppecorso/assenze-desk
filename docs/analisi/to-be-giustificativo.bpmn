<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definizioni_to-be-giustificativo" targetNamespace="https://example.org/assenze-desk">
  <bpmn:collaboration id="Collab_to-be-giustificativo">
    <bpmn:participant id="Pool_to-be-giustificativo" name="Ufficio del personale" processRef="Processo_to-be-giustificativo" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_to-be-giustificativo" name="TO-BE · Richiesta di ferie o permesso con Assenze Desk" isExecutable="false">
    <bpmn:laneSet id="Corsie_to-be-giustificativo">
      <bpmn:lane id="Corsia_operatore" name="Operatore">
        <bpmn:flowNodeRef>N_inizio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_importa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_corregge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_salva</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Corsia_app" name="Assenze Desk">
        <bpmn:flowNodeRef>N_analizza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_righe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_avvisi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_bozza</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_export</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_fine</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_inizio" name="Richiesta ricevuta">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="N_importa" name="Importa o incolla la richiesta">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="N_analizza" name="Legge tipo, giorni e ore; trova il dipendente">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N_righe" name="Righe per giorno con l'orario del cliente; avvisi">
      <bpmn:documentation>Weekend esclusi salvo scelta; avviso se supera le ore residue.</bpmn:documentation>
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="N_avvisi" name="Avvisi?">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_corregge" name="Corregge giorni, ore o tipo">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_salva" name="Salva le righe">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="N_bozza" name="Bozza di conferma al lavoratore">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="N_export" name="Export in Excel delle righe da caricare">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="N_fine" name="Richiesta registrata">
      <bpmn:incoming>F_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="N_inizio" targetRef="N_importa" />
    <bpmn:sequenceFlow id="F_2" sourceRef="N_importa" targetRef="N_analizza" />
    <bpmn:sequenceFlow id="F_3" sourceRef="N_analizza" targetRef="N_righe" />
    <bpmn:sequenceFlow id="F_4" sourceRef="N_righe" targetRef="N_avvisi" />
    <bpmn:sequenceFlow id="F_5" sourceRef="N_avvisi" targetRef="N_corregge" name="Sì" />
    <bpmn:sequenceFlow id="F_6" sourceRef="N_avvisi" targetRef="N_salva" name="No" />
    <bpmn:sequenceFlow id="F_7" sourceRef="N_corregge" targetRef="N_salva" />
    <bpmn:sequenceFlow id="F_8" sourceRef="N_salva" targetRef="N_bozza" />
    <bpmn:sequenceFlow id="F_9" sourceRef="N_bozza" targetRef="N_export" />
    <bpmn:sequenceFlow id="F_10" sourceRef="N_export" targetRef="N_fine" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DI_to-be-giustificativo">
    <bpmndi:BPMNPlane id="Piano_to-be-giustificativo" bpmnElement="Collab_to-be-giustificativo">
      <bpmndi:BPMNShape id="DI_Pool_to-be-giustificativo" bpmnElement="Pool_to-be-giustificativo" isHorizontal="true">
        <dc:Bounds x="10" y="46" width="1425" height="260" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Corsia_operatore" bpmnElement="Corsia_operatore" isHorizontal="true">
        <dc:Bounds x="40" y="46" width="1395" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Corsia_app" bpmnElement="Corsia_app" isHorizontal="true">
        <dc:Bounds x="40" y="176" width="1395" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_inizio" bpmnElement="N_inizio">
        <dc:Bounds x="98" y="94" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_importa" bpmnElement="N_importa">
        <dc:Bounds x="196" y="79" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_analizza" bpmnElement="N_analizza">
        <dc:Bounds x="336" y="209" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_righe" bpmnElement="N_righe">
        <dc:Bounds x="476" y="209" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_avvisi" bpmnElement="N_avvisi" isMarkerVisible="true">
        <dc:Bounds x="653" y="219" width="44" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_corregge" bpmnElement="N_corregge">
        <dc:Bounds x="756" y="79" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_salva" bpmnElement="N_salva">
        <dc:Bounds x="896" y="79" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_bozza" bpmnElement="N_bozza">
        <dc:Bounds x="1036" y="209" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_export" bpmnElement="N_export">
        <dc:Bounds x="1176" y="209" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_fine" bpmnElement="N_fine">
        <dc:Bounds x="1358" y="224" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_F_1" bpmnElement="F_1">
        <di:waypoint x="132" y="111" />
        <di:waypoint x="196" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_2" bpmnElement="F_2">
        <di:waypoint x="314" y="111" />
        <di:waypoint x="325" y="111" />
        <di:waypoint x="325" y="241" />
        <di:waypoint x="336" y="241" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_3" bpmnElement="F_3">
        <di:waypoint x="454" y="241" />
        <di:waypoint x="476" y="241" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_4" bpmnElement="F_4">
        <di:waypoint x="594" y="241" />
        <di:waypoint x="653" y="241" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_5" bpmnElement="F_5">
        <di:waypoint x="675" y="219" />
        <di:waypoint x="675" y="111" />
        <di:waypoint x="756" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_6" bpmnElement="F_6">
        <di:waypoint x="697" y="241" />
        <di:waypoint x="874" y="241" />
        <di:waypoint x="874" y="111" />
        <di:waypoint x="896" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_7" bpmnElement="F_7">
        <di:waypoint x="874" y="111" />
        <di:waypoint x="896" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_8" bpmnElement="F_8">
        <di:waypoint x="1014" y="111" />
        <di:waypoint x="1025" y="111" />
        <di:waypoint x="1025" y="241" />
        <di:waypoint x="1036" y="241" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_9" bpmnElement="F_9">
        <di:waypoint x="1154" y="241" />
        <di:waypoint x="1176" y="241" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_10" bpmnElement="F_10">
        <di:waypoint x="1294" y="241" />
        <di:waypoint x="1358" y="241" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
