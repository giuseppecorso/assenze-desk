<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definizioni_as-is-malattia-1" targetNamespace="https://example.org/assenze-desk">
  <bpmn:collaboration id="Collab_as-is-malattia-1">
    <bpmn:participant id="Pool_as-is-malattia-1" name="Ufficio del personale" processRef="Processo_as-is-malattia-1" />
  </bpmn:collaboration>
  <bpmn:process id="Processo_as-is-malattia-1" name="AS-IS · Malattia, parte 1: dalla mail al certificato" isExecutable="false">
    <bpmn:laneSet id="Corsie_as-is-malattia-1">
      <bpmn:lane id="Corsia_operatore" name="Operatore">
        <bpmn:flowNodeRef>N_inizio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_leggi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_cerca</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_trovato</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_cerca_mano</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_portale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_scarica</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>N_verso_2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="N_inizio" name="Mail di malattia ricevuta">
      <bpmn:outgoing>F_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="N_leggi" name="Legge la mail e copia protocollo, CF e date">
      <bpmn:documentation>Dati ricopiati a mano: errori di trascrizione.</bpmn:documentation>
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_cerca" name="Cerca il dipendente nell'Excel per email o nome">
      <bpmn:documentation>Con un indirizzo diverso da quello in anagrafica non lo trova.</bpmn:documentation>
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="N_trovato" name="Trovato?">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
      <bpmn:outgoing>F_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="N_cerca_mano" name="Cerca a mano per CF o JobOrder">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_portale" name="Apre il portale INPS e incolla CF e protocollo">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="N_scarica" name="Scarica il PDF, lo rinomina e lo archivia">
      <bpmn:documentation>Nomi dei file non uniformi: certificati difficili da ritrovare.</bpmn:documentation>
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="N_verso_2" name="Continua (A)">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:linkEventDefinition id="L_verso_2" name="A" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="N_inizio" targetRef="N_leggi" />
    <bpmn:sequenceFlow id="F_2" sourceRef="N_leggi" targetRef="N_cerca" />
    <bpmn:sequenceFlow id="F_3" sourceRef="N_cerca" targetRef="N_trovato" />
    <bpmn:sequenceFlow id="F_4" sourceRef="N_trovato" targetRef="N_portale" name="Sì" />
    <bpmn:sequenceFlow id="F_5" sourceRef="N_trovato" targetRef="N_cerca_mano" name="No" />
    <bpmn:sequenceFlow id="F_6" sourceRef="N_cerca_mano" targetRef="N_portale" />
    <bpmn:sequenceFlow id="F_7" sourceRef="N_portale" targetRef="N_scarica" />
    <bpmn:sequenceFlow id="F_8" sourceRef="N_scarica" targetRef="N_verso_2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DI_as-is-malattia-1">
    <bpmndi:BPMNPlane id="Piano_as-is-malattia-1" bpmnElement="Collab_as-is-malattia-1">
      <bpmndi:BPMNShape id="DI_Pool_as-is-malattia-1" bpmnElement="Pool_as-is-malattia-1" isHorizontal="true">
        <dc:Bounds x="10" y="46" width="1145" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_Corsia_operatore" bpmnElement="Corsia_operatore" isHorizontal="true">
        <dc:Bounds x="40" y="46" width="1115" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_inizio" bpmnElement="N_inizio">
        <dc:Bounds x="98" y="94" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_leggi" bpmnElement="N_leggi">
        <dc:Bounds x="196" y="79" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_cerca" bpmnElement="N_cerca">
        <dc:Bounds x="336" y="79" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_trovato" bpmnElement="N_trovato" isMarkerVisible="true">
        <dc:Bounds x="513" y="89" width="44" height="44" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_cerca_mano" bpmnElement="N_cerca_mano">
        <dc:Bounds x="616" y="189" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_portale" bpmnElement="N_portale">
        <dc:Bounds x="756" y="79" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_scarica" bpmnElement="N_scarica">
        <dc:Bounds x="896" y="79" width="118" height="64" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_N_verso_2" bpmnElement="N_verso_2">
        <dc:Bounds x="1078" y="94" width="34" height="34" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DI_F_1" bpmnElement="F_1">
        <di:waypoint x="132" y="111" />
        <di:waypoint x="196" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_2" bpmnElement="F_2">
        <di:waypoint x="314" y="111" />
        <di:waypoint x="336" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_3" bpmnElement="F_3">
        <di:waypoint x="454" y="111" />
        <di:waypoint x="513" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_4" bpmnElement="F_4">
        <di:waypoint x="557" y="111" />
        <di:waypoint x="756" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_5" bpmnElement="F_5">
        <di:waypoint x="535" y="133" />
        <di:waypoint x="535" y="221" />
        <di:waypoint x="616" y="221" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_6" bpmnElement="F_6">
        <di:waypoint x="734" y="221" />
        <di:waypoint x="745" y="221" />
        <di:waypoint x="745" y="111" />
        <di:waypoint x="756" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_7" bpmnElement="F_7">
        <di:waypoint x="874" y="111" />
        <di:waypoint x="896" y="111" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_F_8" bpmnElement="F_8">
        <di:waypoint x="1014" y="111" />
        <di:waypoint x="1078" y="111" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
